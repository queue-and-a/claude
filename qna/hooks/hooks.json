{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|TodoWrite",
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/own-tools.sh\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/finish-stage.sh\"" }]
      }
    ]
  }
}
